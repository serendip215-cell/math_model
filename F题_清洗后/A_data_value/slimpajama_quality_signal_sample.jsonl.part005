{"id":"BkiUdJbxK6nrxjHzBcTK","content":"Pías és un municipi de la província de Zamora a la comunitat autònoma de Castella i Lleó. Es troba a la zona d'As Portelas, on es parla majoritàriament gallec.\n\nDemografia\n\nReferències \n\nMunicipis de la província de Zamora","ad_en":[-3.13671875,3.701171875],"rps_doc_mean_word_length":5.027027027027027,"fineweb_edu":[1.0937645435333252],"modernbert_readability":[-4.77734375,1.765625,1.09375,2.17578125,2.048828125,-2.26953125],"qurater":[-2.638671875,-2.95703125,-2.353515625,-2.783203125],"rps_doc_frac_chars_top_2gram":4.301075268817205,"rps_doc_unigram_entropy":3.09368698,"dsir_math":-417.86344122,"dsir_wiki":-409.67224362,"rps_doc_num_sentences":3,"rps_doc_word_count":37.0,"modernbert_professionalism":[-2.509765625,7.125,5.53515625,0.137451171875,-2.732421875,-6.30859375],"rps_doc_frac_unique_words":72.72727272727273,"fluency_en":[-1.1533203125,0.96484375],"rps_doc_frac_no_alph_words":23.42342342342343,"dsir_books":-391.51049529,"modernbert_cleanliness":[-8.2109375,-6.328125,9.046875,6.16015625,5.890625,-10.5234375],"rps_lines_uppercase_letter_fraction":46.92144782441278,"modernbert_reasoning":[7.515625,9.5625,1.1513671875,-4.56640625,-4.90234375,-5.66796875],"rps_doc_frac_chars_top_3gram":15,"rps_lines_ending_with_terminal_punctution_mark":57.14285714285714,"rps_lines_numerical_chars_fraction":0.0,"sub_path":"","_source_domain":"wikipedia","_source_path":"wikipedia/part-6777d8857c6e-000341.jsonl"}
{"id":"BkiUdQQ5i7PA9OlIEXBK","content":"Den Fredløse er en amerikansk stumfilm fra 1916 af Ralph Ince.\n\nMedvirkende \n Anita Stewart som Muriel Fleming.\n John S. Robertson som Philip Lewis.\n Richard Turner som Graydon Burton.\n Virginia Norden som Mrs. Fleming.\n Winthrop Mendell som Herman Slade.\n\nReferencer\n\nEksterne henvisninger \n\n \n\nStumfilm fra USA\nAmerikanske film fra 1916\nDramafilm fra USA","ad_en":[-3.296875,3.890625],"rps_doc_mean_word_length":5.568627450980392,"fineweb_edu":[0.9544957876205444],"modernbert_readability":[-6.45703125,0.023590087890625,0.03582763671875,2.470703125,3.32421875,-0.377197265625],"qurater":[-1.8466796875,-2.400390625,-0.320068359375,-3.240234375],"rps_doc_frac_chars_top_2gram":7.746478873239436,"rps_doc_unigram_entropy":3.55657966,"dsir_math":-568.66965018,"dsir_wiki":-551.9002749,"rps_doc_num_sentences":9,"rps_doc_word_count":51.0,"modernbert_professionalism":[-3.544921875,7.0078125,4.71484375,-0.197265625,-2.6953125,-5.87890625],"rps_doc_frac_unique_words":78.43137254901961,"fluency_en":[-0.3115234375,0.79931640625],"rps_doc_frac_no_alph_words":22.752808988764045,"dsir_books":-558.10877763,"modernbert_cleanliness":[-8.0703125,-7.3203125,6.9296875,3.0546875,6.45703125,-8.15625],"rps_lines_uppercase_letter_fraction":35.67418089208096,"modernbert_reasoning":[8.265625,10.4609375,0.810546875,-5.5234375,-6.5,-6.40234375],"rps_doc_frac_chars_top_3gram":0,"rps_lines_ending_with_terminal_punctution_mark":66.66666666666666,"rps_lines_numerical_chars_fraction":1.8797814207650272,"sub_path":"","_source_domain":"wikipedia","_source_path":"wikipedia/part-6777d8857c6e-000341.jsonl"}
